#!/bin/sh
#
# @name AgroSwarm SITL Custom
#
# @type Quadrotor
#
# @maintainer Freddy (AgroSwarmAI)
#

. ${R}etc/init.d/rc.mc_defaults

# Heredar configuración base de simulador x500
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500}

param set-default SIM_GZ_EN 1

# Configuración de sensores para SITL (Alta fidelidad para AWS)
param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 0

# --- CONFIGURACIÓN DE PRODUCCIÓN AGROSWARM (AWS READY) ---
# Desactivar magnetómetro (mecanismo oficial de anulación)
param set-default SYS_HAS_MAG 0
param set-default EKF2_MAG_TYPE 5

# EKF2 Standard (Sin hacks de baja potencia)
param set-default EKF2_GPS_CHECK 1
param set-default EKF2_HGT_REF 0
param set-default COM_ARM_WO_GPS 0
param set-default COM_ARM_EKF_YAW 0.5

# Seguridad y Failsafes Reales (Standard PX4)
param set-default SYS_LOCKSTEP 1
param set-default COM_ARM_IMU_ACC 0.1
param set-default COM_ARM_IMU_GYR 0.1
param set-default COM_SENS_STK_IT 0.5

# Operaciones sin RC físico
param set-default NAV_RCL_ACT 0

# --- Geometría x500 ---
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM  0.05

param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM  0.05

param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.05

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# --- Actuador VRA (servo aux 1, bomba de aspersión AgroSwarm) ---
# SV_FUNC1=201 mapea el canal 1 del bridge gz a ACTUATOR_FUNCTION_SERVO0
# (actuator_servos.control[0]). DIS=0 y FAIL=0 garantizan que la bomba quede
# apagada en disarm o failsafe — fail-safe químico crítico para hardware real.
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_MIN1 0
param set-default SIM_GZ_SV_MAX1 1000
param set-default SIM_GZ_SV_DIS1 0
param set-default SIM_GZ_SV_FAIL1 0

param set-default MPC_THR_HOVER 0.60
