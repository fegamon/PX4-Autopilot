#!/bin/sh
#
# @name AgroSwarm Hexarotor (EFT E610)
#
# @type Hexarotor x
# @class Copter
#
# @maintainer Freddy (AgroSwarmAI)
#
# Target hardware: Cube Orange+ on EFT E610 hexarotor airframe.
# Motors: Hobbywing X8 on PWM_MAIN 1-6 (functions 101-106).
# Chemical pump (VRA sprayer): actuator_servos ch0 mapped to PWM_AUX 1 (function 201).
#   PWM_AUX_DIS1=0 / PWM_AUX_FAIL1=0 guarantee pump-off on disarm and failsafe.
#
# NOTE: arm length and X8 motor KM values below are SITL-compatible placeholders
# copied from stock 6001_hexa_x. Real E610 arm length + X8 KM are deferred to
# pre-flight tuning (open task: hexa-e610 physical commissioning).
#

. ${R}etc/init.d/rc.mc_defaults

param set-default MAV_TYPE 13

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 6

# --- Hexa-X geometry (stock PX4 6001_hexa_x, 60-degree spacing) ---
# KM sign convention: negative = CW (motors 0, 2, 5); positive = CCW (motors 1, 3, 4).
# Arm length placeholder: 0.5 m / 0.25 m (hexa-X unit geometry).
# Replace with real E610 arm length during physical commissioning.
param set-default CA_ROTOR0_PX 0
param set-default CA_ROTOR0_PY 0.5
param set-default CA_ROTOR0_KM -0.05

param set-default CA_ROTOR1_PX 0
param set-default CA_ROTOR1_PY -0.5
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.43
param set-default CA_ROTOR2_PY -0.25
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.43
param set-default CA_ROTOR3_PY 0.25
param set-default CA_ROTOR3_KM 0.05

param set-default CA_ROTOR4_PX 0.43
param set-default CA_ROTOR4_PY 0.25
param set-default CA_ROTOR4_KM 0.05

param set-default CA_ROTOR5_PX -0.43
param set-default CA_ROTOR5_PY -0.25
param set-default CA_ROTOR5_KM -0.05

# --- ESC output (Cube Orange+ PWM_MAIN 1-6 → motor functions 101-106) ---
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_FUNC5 105
param set-default PWM_MAIN_FUNC6 106

# --- Chemical pump — actuator_servos ch0 (PR-3 failsafe invariant) ---
# Function 201 = ACTUATOR_FUNCTION_SERVO0 (actuator_servos.control[0]).
# DIS=0 and FAIL=0: pump is off on disarm and in any failsafe state.
param set-default PWM_AUX_FUNC1 201
param set-default PWM_AUX_DIS1 0
param set-default PWM_AUX_FAIL1 0

# --- RC-loss failsafe: re-enabled for physical flight ---
# 2 = Return to launch on RC loss. Must NOT be 0 on physical airframes.
param set-default NAV_RCL_ACT 2
